# 仅在本地 .env 填写真实凭据。密钥永不进入前端。
HOST=127.0.0.1
PORT=8787
# 容器/服务器首次初始化管理员：admin；在部署平台Secret中填8–128位密码。
# 只在没有管理员时创建，已存在管理员时不会重置。初始化后移除此变量。
ADMIN_INITIAL_PASSWORD=
# 单模型配置，也可在界面“模型设置”填写；界面保存值优先。
MODEL_NAME=qwen3.8-max
MODEL_API_KEY=
# 固定适配 https://token.agentone.work/v1/chat/completions
FFMPEG_PATH=
FFPROBE_PATH=
JUDGE_EXPIRES_AT=
